# Local SQLite (default). For production Postgres:
# DATABASE_URL="postgresql://shieldtrack:shieldtrack@localhost:5432/shieldtrack?schema=public"
# and switch prisma/schema.prisma provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Ethereum RPC (required for Tornado + Railgun). Prefer a paid endpoint for production.
ETH_RPC_URL="https://ethereum.publicnode.com"

# Optional — improves “next txs after OUT” (native ETH sends). Without it we still
# scan ERC-20 Transfer logs via ETH RPC, and link out to Etherscan.
# ETHERSCAN_API_KEY=

# Optional additional EVM RPCs
# ARBITRUM_RPC_URL=
# POLYGON_RPC_URL=
# BSC_RPC_URL=

# How far back to backfill on first run (blocks). ~12s/block → 7200 ≈ 24h
INDEXER_LOOKBACK_BLOCKS=7200
INDEXER_POLL_MS=8000
INDEXER_LOG_CHUNK=2000

# USD thresholds for LARGE / ULTRA badges
LARGE_USD=50000
ULTRA_USD=500000
# History panel only lists transfers at/above this USD size
HISTORY_MIN_USD=100000

# Zcash public indexer (CipherScan mainnet API — do not use cipherscan.app/api stub)
ZCASH_API_BASE="https://api.mainnet.cipherscan.app/api"
ZCASH_POLL_MS=15000

# Optional CoinGecko (leave empty to use public endpoint)
# COINGECKO_API_BASE="https://api.coingecko.com/api/v3"
